{
  "name": "custom-ha-cards",
  "version": "0.4.3",
  "description": "Custom Home Assistant Lovelace cards — climate, lights, weather, air quality, appliances, presence, to-do, status, quick actions and more",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "shots": "node test/shoot.mjs",
    "test:editors": "npm run build && node test/editors.mjs",
    "pre-commit": "pretty-quick --staged",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "playwright": "^1.47.0",
    "pre-commit": "^2.0.0",
    "prettier": "^3.9.6",
    "pretty-quick": "^4.2.2",
    "typescript": "^5.5.0",
    "vite": "^8.2.2"
  },
  "pre-commit": [
    "pre-commit"
  ]
}
